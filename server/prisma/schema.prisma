// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// CATEGORY
// ─────────────────────────────────────────────
model Category {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  slug      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())

  @@map("categories")
}

// ─────────────────────────────────────────────
// PRODUCT
// ─────────────────────────────────────────────
model Product {
  id          Int      @id @default(autoincrement())
  name        String
  slug        String   @unique
  description String
  price       Float
  images      String[] // Array of image URLs
  colors      String[] // Array of hex codes or color names
  stock       Int      @default(0)
  featured    Boolean  @default(false)

  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  categoryId Int

  orders    Order[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("products")
}

// ─────────────────────────────────────────────
// ORDER  (Lead Form Submission)
// ─────────────────────────────────────────────
model Order {
  id           Int         @id @default(autoincrement())
  customerName String
  address      String
  whatsapp     String
  phone        String
  productName  String      // Snapshot of product name at time of order
  quantity     Int         @default(1) // Number of units ordered

  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  productId Int

  status    OrderStatus @default(PENDING)
  notes     String?     // Admin internal notes

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("orders")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  CANCELLED
}
